{
  "name": "yawn-yaml",
  "version": "3.0.0",
  "license": "MIT",
  "author": "Mohsen Azimi",
  "description": "YAML parser that preserves comments and styling",
  "keywords": [
    "yaml",
    "parser",
    "comments",
    "preserve",
    "formatting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsen1/yawn-yaml.git"
  },
  "typings": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/yawn-yaml.esm.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "start": "parcel demo/index.html",
    "build": "./build.sh",
    "test": "tsdx test",
    "lint": "tsdx lint",
    "prepare": "tsdx build",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "husky": {
    "hooks": {
      "pre-commit": "tsdx lint"
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/yawn-yaml.cjs.production.min.js",
      "limit": "100 KB"
    },
    {
      "path": "dist/yawn-yaml.esm.js",
      "limit": "100 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.1.2",
    "buffer": "^5.5.0||^6.0.0",
    "dedent": "^1.5.3",
    "husky": "^9.0.11",
    "os-browserify": "^0.3.0",
    "parcel": "^2.12.0",
    "process": "^0.11.10",
    "size-limit": "^11.1.2",
    "tsdx": "^0.14.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "util": "^0.12.3"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
